# Node
NODE_ID=1
NODE_ADDRESS=localhost:50051
GRPC_PORT=50051

# Database
POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bully
POSTGRES_PORT=5432
POSTGRES_SSL_MODE=disable

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Storage
STORAGE_ENDPOINT=localhost:9000
STORAGE_BUCKET=bully
STORAGE_ACCESS_KEY=test
STORAGE_SECRET_KEY=test
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false
LOCALSTACK_AUTH_TOKEN=

# Memberlist
MEMBERLIST_BIND_ADDR=localhost
MEMBERLIST_BIND_PORT=7947
MEMBERLIST_SEEDS=localhost:7947

# Election
ELECTION_TIMEOUT=5s
ELECTION_ANNOUNCE_RETRY_INTERVAL=200ms
ELECTION_SEND_RETRY_INTERVAL=100ms

# Scheduler
SCHEDULER_POLL_INTERVAL=5s
SCHEDULER_BATCH_SIZE=10
SCHEDULER_STRATEGY=round_robin
SCHEDULER_LEASE_DURATION=3m

# Worker
WORKER_LEASE_RENEWAL_INTERVAL=30s
WORKER_RPC_TIMEOUT=5s
